{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lolcoded-site",
  "compatibility_date": "2026-10-01",
  // Assets-only: no Worker script, so requests are served free and never count
  // against the Workers request quota.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "lolcoded.dev", "custom_domain": true },
    { "pattern": "www.lolcoded.dev", "custom_domain": true }
  ]
}
