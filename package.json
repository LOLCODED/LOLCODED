{
  "name": "lolcoded-site",
  "version": "0.0.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.147.0"
  },
  "private": true,
  "scripts": {
    "dev": "bun run dev.ts",
    "build": "tsc --noEmit && bun run build.ts",
    "lint": "eslint .",
    "deploy": "bun run build && wrangler deploy",
    "preview": "bun run build && wrangler dev"
  },
  "type": "module"
}
